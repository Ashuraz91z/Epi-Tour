#!/usr/bin/env python3
"""Synchronise les métadonnées des journaux locaux, sans lire les secrets des outils.

Le texte des demandes ne part que si cette machine l'a choisi (fichier « partage-demandes », posé par la commande
de l'étage avec --partager-demandes). Le quota Claude est lu ici aussi (claude_quota, données /usage de Claude Code), au plus toutes les 15 min.
Mac, Linux et Windows (Python 3.8+, bibliothèque standard seulement). Sous Windows, ~ désigne %USERPROFILE%."""
from datetime import datetime
import glob
import json
import math
import os
from pathlib import Path
import queue
import shutil
import subprocess
import sys
import threading
import time
import urllib.parse
from tour_http import request, ConnectionError

CONF = Path.home() / '.config' / 'tour'
# Journaux lus : dossier sous ~, puis motif des fichiers (séparateurs natifs, donc \ sous Windows).
JOURNALS = [('codex', ('.codex', 'sessions'), ('*', '*', '*', 'rollout-*.jsonl')),
            ('claude', ('.claude', 'projects'), ('*', '*.jsonl'))]


def stamp(value):
    try:
        return datetime.fromisoformat(value.replace('Z', '+00:00')).timestamp()
    except (ValueError, TypeError, AttributeError):
        return 0


def prompt_text(source, row, payload):
    """Texte d'une demande tapée par la personne, ou None (résultat d'outil, message système, commande locale)."""
    if source == 'codex':
        if row.get('type') == 'event_msg' and payload.get('type') == 'user_message' and isinstance(payload.get('message'), str):
            return payload['message']
        return None
    message = row.get('message')
    if row.get('type') != 'user' or row.get('isMeta') or not isinstance(message, dict):
        return None
    content = message.get('content')
    if isinstance(content, list):
        content = ' '.join(b.get('text', '') for b in content if isinstance(b, dict) and b.get('type') == 'text')
    if not isinstance(content, str) or not content.strip() or content.lstrip().startswith(('<', 'Caveat:')):
        return None
    return content


def parse(source, lines, share=False):
    """share : joindre le texte de la dernière demande (300 caractères au plus), si la machine a choisi de le partager."""
    result = {'session_id': None, 'hook_event_name': None}
    usage, prompt = None, None
    for line in lines:
        try:
            row = json.loads(line)
        except (ValueError, UnicodeError):
            continue
        if not isinstance(row, dict):
            continue
        payload = row.get('payload') or {}
        if not isinstance(payload, dict):
            continue
        if share:
            prompt = prompt_text(source, row, payload) or prompt
        event, tool = None, None
        if source == 'codex':
            if row.get('type') == 'session_meta':
                result['session_id'] = payload.get('id')
            kind = payload.get('type')
            if row.get('type') == 'event_msg':
                event = {'task_started': 'UserPromptSubmit', 'task_complete': 'Stop', 'turn_aborted': 'Stop'}.get(kind)
                limits = payload.get('rate_limits')
                if isinstance(limits, dict):
                    def window(w):
                        pct = w.get('used_percent') if isinstance(w, dict) else None
                        return {'pct': pct, 'resets_at': w.get('resets_at')} if type(pct) in (int, float) and math.isfinite(pct) else None
                    windows = {k: w for k, w in [('five_hour', window(limits.get('primary'))), ('seven_day', window(limits.get('secondary')))] if w is not None}
                    measured = stamp(row.get('timestamp'))
                    if windows and measured >= (usage or {}).get('ts', 0):
                        usage = {**(usage or {}), **windows, 'ts': measured}
                        # Formule ChatGPT (plus, pro…) : sert au rôle de Codex dans le jeu, rien d'autre n'est lu du compte.
                        if isinstance(limits.get('plan_type'), str):
                            usage['plan'] = limits['plan_type'][:24]
            elif row.get('type') == 'response_item':
                if kind in ('function_call', 'custom_tool_call'):
                    event, tool = 'PreToolUse', payload.get('name')
                elif kind in ('function_call_output', 'custom_tool_call_output', 'reasoning'):
                    event = 'PreToolUse'
                elif kind == 'message' and payload.get('role') == 'assistant':
                    event = 'Stop' if payload.get('phase') == 'final_answer' else 'PreToolUse'
            if row.get('type') == 'turn_context':
                result['cwd'] = os.path.basename(str(payload.get('cwd', '')))
                result['model'] = payload.get('model')
        else:
            if row.get('sessionId'):
                result['session_id'] = row['sessionId']
            if row.get('cwd'):
                result['cwd'] = os.path.basename(row['cwd'])
            message = row.get('message') or {}
            if not isinstance(message, dict):
                continue
            if row.get('type') == 'user':
                event = 'UserPromptSubmit'
            elif row.get('type') == 'assistant':
                result['model'] = message.get('model')
                blocks = message.get('content', [])
                tools = [block.get('name') for block in blocks if isinstance(block, dict) and block.get('type') == 'tool_use'] if isinstance(blocks, list) else []
                event = 'PreToolUse' if tools or message.get('stop_reason') == 'tool_use' else 'Stop'
                tool = tools[-1] if tools else None
            elif row.get('type') == 'system' and row.get('subtype') == 'turn_duration':
                event = 'Stop'
        observed = stamp(row.get('timestamp'))
        if event and observed >= result.get('observed_at', 0):
            result.update(hook_event_name=event, observed_at=observed, tool_name=str(tool or 'activité locale')[:80])
    if usage and source == 'codex' and usage['ts']:
        result['usage'] = {'chatgpt': usage}
    if prompt:
        result['prompt'] = ' '.join(prompt.split())[:300]
    return result


def tool_label(name):
    """Nom d'outil court pour les stats : « Bash », « Edit », « mcp · github » (jamais ses arguments)."""
    name = str(name or '')
    if name.startswith('mcp__'):
        name = 'mcp · ' + (name.split('__')[1] if len(name.split('__')) > 1 else '')
    return name[:40]


def count_activity(source, lines, since):
    """Depuis `since` (horodatage) : appels d'outils, demandes tapées et nom des outils appelés. De simples compteurs :
    ni le contenu des demandes, ni les arguments ou résultats des outils. Renvoie (actions, dernier horodatage,
    demandes, {outil: nombre})."""
    count, latest, prompts, tools = 0, since, 0, {}
    for line in lines:
        try:
            row = json.loads(line)
        except (ValueError, UnicodeError):
            continue
        if not isinstance(row, dict):
            continue
        at = stamp(row.get('timestamp'))
        if at <= since:
            continue
        latest = max(latest, at)
        payload = row.get('payload') if isinstance(row.get('payload'), dict) else {}
        if prompt_text(source, row, payload):
            prompts += 1
        called = []
        if source == 'codex':
            if row.get('type') == 'response_item' and payload.get('type') in ('function_call', 'custom_tool_call'):
                called.append(payload.get('name'))
        elif row.get('type') == 'assistant' and isinstance(row.get('message'), dict):
            blocks = row['message'].get('content')
            if isinstance(blocks, list):
                called += [block.get('name') for block in blocks if isinstance(block, dict) and block.get('type') == 'tool_use']
        count += len(called)
        for name in called:
            label = tool_label(name)
            if label:
                tools[label] = tools.get(label, 0) + 1
    top = dict(sorted(tools.items(), key=lambda kv: -kv[1])[:10])
    return min(count, 200), latest, min(prompts, 100), top


def count_actions(source, lines, since):
    """Nombre d'appels d'outils écrits après `since` (horodatage) : un simple compteur, aucun contenu lu."""
    actions, latest, _, _ = count_activity(source, lines, since)
    return actions, latest


def send(site, key, host, source, payload):
    query = urllib.parse.urlencode({'src': source, 'host': host})
    request(site, key, '/e?' + query, payload)


def journals(folder, pattern):
    """Journaux sous ~/folder ; le dossier personnel est échappé pour glob (un [ dans le nom ne casse pas la recherche)."""
    return glob.iglob(os.path.join(glob.escape(str(Path.home().joinpath(*folder))), *pattern))


def setting(name):
    # utf-8-sig : un fichier réenregistré par le Bloc-notes de Windows (avec BOM) reste lisible.
    return (CONF / name).read_text(encoding='utf-8-sig').strip()


def exclusive(lock):
    """Verrou non bloquant : False si une autre synchronisation tourne déjà (fcntl sous Unix, msvcrt sous Windows)."""
    if sys.platform == 'win32':
        import msvcrt
        try:
            lock.seek(0)
            msvcrt.locking(lock.fileno(), msvcrt.LK_NBLCK, 1)  # libéré à la fermeture du fichier
        except OSError:
            return False
        return True
    import fcntl
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return False
    return True


QUOTA_EVERY = 15 * 60


def claude_binary():
    """Claude Code installé sur la machine : dans le PATH, ou aux emplacements habituels (installateur, Homebrew, npm,
    nvm, bun, volta, pnpm) ; cron et launchd ont un PATH réduit et ne les voient pas tout seuls."""
    names = ('claude.exe', 'claude.cmd', 'claude') if sys.platform == 'win32' else ('claude',)
    home = Path.home()
    nvm = sorted(glob.glob(os.path.join(glob.escape(str(home)), '.nvm', 'versions', 'node', '*', 'bin', 'claude')), reverse=True)
    places = [shutil.which(name) for name in names] + [str(home / '.local' / 'bin' / name) for name in names] + [
        str(home / '.claude' / 'local' / 'claude'), '/opt/homebrew/bin/claude', '/usr/local/bin/claude', '/usr/bin/claude',
        *nvm, str(home / '.npm-global' / 'bin' / 'claude'), str(home / '.bun' / 'bin' / 'claude'),
        str(home / '.volta' / 'bin' / 'claude'), str(home / 'Library' / 'pnpm' / 'claude'), str(home / '.local' / 'share' / 'pnpm' / 'claude'),
        os.path.join(os.environ.get('APPDATA', ''), 'npm', 'claude.cmd')]
    return next((p for p in places if p and os.path.isfile(p) and os.access(p, os.X_OK)), None)


def quota_windows(out):
    """Fenêtres 5 h et 7 jours lues dans les événements « rate_limit_event » de la sortie stream-json : forme groupée
    (unifiedWindows) ou une fenêtre par événement (rateLimitType). Renvoie (fenêtres, clés vues si rien n'est lisible)."""
    windows, seen = {}, set()
    for line in out.splitlines():
        if '"rate_limit_event"' not in line:
            continue
        try:
            info = json.loads(line).get('rate_limit_info') or {}
        except ValueError:
            continue
        if not isinstance(info, dict):
            continue
        seen.update(info)
        found = info.get('unifiedWindows') if isinstance(info.get('unifiedWindows'), dict) else {info.get('rateLimitType'): info}
        for name, w in found.items():
            if name not in ('five_hour', 'seven_day') or not isinstance(w, dict):
                continue
            used, reset = w.get('utilization'), w.get('resetsAt')
            if isinstance(used, (int, float)) and isinstance(reset, (int, float)):
                windows[name] = {'pct': round(used * 100 if used <= 1.5 else used), 'resets_at': reset}
    return windows, sorted(str(k) for k in seen)[:6]


USAGE_REQUEST = 'penthouse-usage'
CLAUDE_ARGS = ['--print', '--no-session-persistence', '--model', 'haiku', '--tools', '', '--strict-mcp-config',
               '--mcp-config', '{"mcpServers":{}}', '--output-format', 'stream-json', '--verbose']


def ask_usage(binary, env):
    """Demande à Claude Code ses données /usage (requête de contrôle « get_usage » en stream-json) : quotas de
    l'abonnement, sans requête au modèle. Renvoie (réponse ou None, sortie, erreur)."""
    proc = subprocess.Popen([binary] + CLAUDE_ARGS + ['--input-format', 'stream-json'], cwd=str(Path.home()), env=env,
                            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
                            creationflags=getattr(subprocess, 'CREATE_NO_WINDOW', 0))
    lines = queue.Queue()

    def read():
        for line in proc.stdout:
            lines.put(line)
        lines.put(None)
    threading.Thread(target=read, daemon=True).start()
    answer, out = None, []
    try:
        proc.stdin.write(json.dumps({'type': 'control_request', 'request_id': USAGE_REQUEST,
                                     'request': {'subtype': 'get_usage', 'skip_behaviors': True}}) + '\n')
        proc.stdin.flush()
        deadline = time.time() + 60
        while answer is None and time.time() < deadline:
            try:
                line = lines.get(timeout=max(0.1, deadline - time.time()))
            except queue.Empty:
                break
            if line is None:
                break
            out.append(line)
            try:
                row = json.loads(line)
            except ValueError:
                continue
            response = row.get('response') if isinstance(row, dict) else None
            if row.get('type') == 'control_response' and isinstance(response, dict) and response.get('request_id') == USAGE_REQUEST:
                answer = response
    except OSError:
        pass
    finally:
        try:
            proc.stdin.close()
        except OSError:
            pass
        try:
            proc.wait(timeout=10)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait()
    error = ' '.join((proc.stderr.read() or '').strip().splitlines()[:1])
    return answer, ''.join(out), error


def usage_answer(answer):
    """Fenêtres 5 h et 7 jours d'une réponse get_usage (utilisation en %, reset en ISO 8601), ou (None, raison)."""
    if not isinstance(answer, dict):
        return None, None
    if answer.get('subtype') != 'success':
        return None, 'erreur : ' + str(answer.get('error') or 'get_usage refusé')
    data = answer.get('response') if isinstance(answer.get('response'), dict) else {}
    if data.get('rate_limits_available') is False:
        # Claude Code ne lit les quotas que connecté par l'abonnement (/login), avec l'accès au profil.
        plan = data.get('subscription_type')
        return None, 'sans quota' + (' · abonnement ' + str(plan) if plan else ' · pas connecté par un abonnement Claude')
    limits = data.get('rate_limits') if isinstance(data.get('rate_limits'), dict) else {}
    windows = {}
    for name in ('five_hour', 'seven_day'):
        w = limits.get(name)
        if isinstance(w, dict) and isinstance(w.get('utilization'), (int, float)):
            windows[name] = {'pct': round(w['utilization'])}
            reset = stamp(w.get('resets_at')) if isinstance(w.get('resets_at'), str) else w.get('resets_at')
            if isinstance(reset, (int, float)) and reset > 0:
                windows[name]['resets_at'] = round(reset)
    return (windows, None) if windows else (None, 'format : ' + ','.join(sorted(map(str, limits)))[:60])


def claude_quota(site, key, host):
    """Quota Claude (fenêtres 5 h et 7 jours), au plus toutes les 15 min. D'abord les données /usage de Claude Code
    (get_usage, sans requête au modèle, rien n'est consommé) ; à défaut, les événements « rate_limit_event » d'une
    mini-requête (Haiku, sans outils ni session), seulement si Claude Code a servi depuis la fin de la fenêtre de 5 h
    (elle n'en ouvre jamais une). Désactivable : fichier « sans-quota-claude ». Chaque essai envoie son résultat
    (ok, introuvable, erreur…) : le site dit pourquoi le quota manque."""
    if os.environ.get('TOUR_SKIP'):
        return
    state_file, now = CONF / 'usage-state.json', time.time()
    try:
        state = json.loads(state_file.read_text())
        state = {'last_probe': float(state.get('last_probe', 0)), 'resets_at': float(state.get('resets_at', 0))}
    except (OSError, ValueError, TypeError, AttributeError):
        state = {'last_probe': 0, 'resets_at': 0}
    if now - state['last_probe'] < QUOTA_EVERY:
        return

    def report(status):
        send(site, key, host, 'usage', {'hook_event_name': 'usage', 'info': {'claude_quota': status[:90], 'claude_quota_at': now}})
    state['last_probe'] = now
    state_file.write_text(json.dumps(state))  # avant la requête : jamais deux essais en 15 min, même s'il échoue
    if (CONF / 'sans-quota-claude').exists():
        return report('désactivé')
    binary = claude_binary()
    if not binary:
        print('Quota Claude : Claude Code introuvable.')
        return report('introuvable')
    # Le dossier de claude et les dossiers habituels en tête du PATH : un claude installé par npm lance « node ».
    path = os.pathsep.join([os.path.dirname(binary), str(Path.home() / '.local' / 'bin'), '/opt/homebrew/bin', '/usr/local/bin', os.environ.get('PATH', '')])
    env = {**os.environ, 'PATH': path, 'TOUR_SKIP': '1'}  # TOUR_SKIP : les hooks éventuels ignorent cette session
    try:
        answer, out, error = ask_usage(binary, env)
    except (OSError, subprocess.SubprocessError) as exc:
        answer, out, error = None, '', type(exc).__name__
    usage, status = usage_answer(answer)
    if status and status.startswith('sans quota'):
        # Causes connues, sans jamais lire ni envoyer leur valeur : une clé d'API prend le pas sur l'abonnement, et un
        # jeton « claude setup-token » n'a pas l'accès au profil qui donne les quotas.
        if os.environ.get('ANTHROPIC_API_KEY') or os.environ.get('ANTHROPIC_AUTH_TOKEN'):
            status += ' · clé d’API dans l’environnement'
        elif os.environ.get('CLAUDE_CODE_OAUTH_TOKEN'):
            status += ' · jeton setup-token sans accès au profil'
    if not usage and not (status or '').startswith('sans quota'):
        # Repli : une mini-requête, seulement si Claude Code a servi depuis la fin de la fenêtre (jamais pour l'ouvrir).
        used = now < state['resets_at'] or any(os.path.getmtime(log) > state['resets_at'] for log in journals(('.claude', 'projects'), ('*', '*.jsonl')))
        if used:
            try:
                run = subprocess.run([binary] + CLAUDE_ARGS + ['--effort', 'low', 'Réponds seulement OK.'], cwd=str(Path.home()), env=env,
                                     stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=90,
                                     creationflags=getattr(subprocess, 'CREATE_NO_WINDOW', 0))
                usage, keys = quota_windows(run.stdout or '')
                error = error or ' '.join((run.stderr or '').strip().splitlines()[:1])
                if not usage and keys:
                    status = status or 'format : ' + ','.join(keys)
            except subprocess.TimeoutExpired:
                error = error or 'pas de réponse en 90 s'
            except (OSError, subprocess.SubprocessError) as exc:
                error = error or type(exc).__name__
    if not usage:
        status = status or ('erreur : ' + error if error else 'sans quota')
        print('Quota Claude non lu (' + status + ') · ' + binary)
        return report(status)
    if 'resets_at' in usage.get('five_hour', {}):
        state['resets_at'] = usage['five_hour']['resets_at']
        state_file.write_text(json.dumps(state))
    send(site, key, host, 'usage', {'hook_event_name': 'usage', 'usage': {'claude': {**usage, 'ts': now}},
                                    'info': {'claude_quota': 'ok', 'claude_quota_at': now}})
    print('Quota Claude envoyé.')


def main():
    CONF.mkdir(parents=True, exist_ok=True)
    # Mode « a » : ne tronque pas un fichier qu'une autre synchronisation tient verrouillé (Windows).
    with (CONF / 'sync.lock').open('a') as lock:
        if not exclusive(lock):
            return
        site = setting('url').rstrip('/')
        key = setting('secret')
        host = setting('host')
        share = (CONF / 'partage-demandes').exists()
        checkpoint = CONF / 'sync-state.json'
        try:
            saved = json.loads(checkpoint.read_text())
            old = saved.get('files', {}) if isinstance(saved, dict) and saved.get('version') == 2 else {}
            if not isinstance(old, dict):
                old = {}
        except (OSError, ValueError):
            old = {}
        current, count = {}, 0
        for source, folder, pattern in JOURNALS:
            candidates = []
            for name in journals(folder, pattern):
                try:
                    info = os.stat(name)
                    if time.time() - info.st_mtime < 3600:
                        candidates.append((info.st_mtime, name, info.st_size))
                except OSError:
                    continue
            # shortcut: 12 sessions récentes par outil et 300 Ko par journal ; étendre si une machine dépasse ce volume.
            for modified, name, size in sorted(candidates, reverse=True)[:12]:
                signature = [modified, size]
                previous = old.get(name) if isinstance(old.get(name), list) else []
                if previous[:2] == signature:
                    current[name] = previous
                    continue
                # Actions comptées depuis le dernier relevé de ce journal (ou sur la dernière heure au premier passage).
                since = previous[2] if len(previous) > 2 and isinstance(previous[2], (int, float)) else time.time() - 3600
                try:
                    with open(name, 'rb') as file:
                        header = file.readline()
                        file.seek(max(0, size - 300000))
                        lines = [header] + file.readlines()
                    payload = parse(source, lines, share)
                    actions, latest, prompts, tools = count_activity(source, lines, since)
                    if payload.get('session_id') and payload.get('observed_at', 0) > time.time() - 3600:
                        payload['sync'] = True
                        if actions:
                            payload['actions'] = actions
                        if prompts:
                            payload['prompts'] = prompts
                        if tools:
                            payload['tools'] = tools
                        send(site, key, host, source, payload)
                        count += 1
                    current[name] = signature + [latest]
                except (OSError, ValueError, ConnectionError):
                    continue  # Un envoi refusé n'est pas marqué comme reçu : il sera retenté.
        temp = checkpoint.with_suffix('.tmp')
        with temp.open('w') as file:
            json.dump({"version": 2, "files": current}, file)
        os.chmod(temp, 0o600)
        os.replace(temp, checkpoint)
        print(str(count) + ' session(s) synchronisée(s).')
        try:
            claude_quota(site, key, host)
        except (OSError, ValueError, ConnectionError):
            print('Quota Claude non mesuré cette fois.')


if __name__ == '__main__':
    if sys.stdout is None:
        # pythonw (tâche planifiée Windows) : pas de console, le compte rendu va dans sync.log, limité à 1 Mo.
        try:
            CONF.mkdir(parents=True, exist_ok=True)
            log = CONF / 'sync.log'
            sys.stdout = sys.stderr = open(log, 'w' if log.exists() and log.stat().st_size > 1000000 else 'a', encoding='utf-8')
        except OSError:
            pass
    try:
        main()
    except ConnectionError as error:
        print(str(error))
        raise SystemExit(1)
    except (OSError, ValueError, KeyError):
        print('Synchronisation impossible : vérifier la configuration et le réseau.')
        raise SystemExit(1)
