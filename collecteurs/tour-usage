#!/usr/bin/env python3
"""Mesure le quota Claude (fenêtres 5 h et 7 jours) et l'envoie à la tour. Lancé toutes les 5 min par cron (dev).

Claude ne donne son quota qu'en réponse à une requête : une mini-requête (Haiku, sans outils) au plus
toutes les 15 min, et seulement si la fenêtre de 5 h est déjà ouverte ou si une session Claude a tourné
depuis sa fin. Ainsi la sonde n'ouvre jamais une fenêtre à elle seule.
"""
import json
import os
import subprocess
import time
import urllib.request

CONF = os.path.expanduser("~/.config/tour/")
STATE = CONF + "usage-state.json"
EVERY = 15 * 60
read = lambda name: open(CONF + name).read().strip()

now = time.time()
try:
    st = json.load(open(STATE))
except (OSError, ValueError):
    st = {"last_probe": 0, "resets_at": 0}
if now - st["last_probe"] < EVERY:
    raise SystemExit
st_try = dict(st, last_probe=now)
if now >= st["resets_at"]:
    tour = json.load(urllib.request.urlopen(read("url") + "/state", timeout=5))
    if not any(s["src"] == "claude" and s["updated"] > st["resets_at"] for s in tour["sessions"]):
        raise SystemExit

json.dump(st_try, open(STATE, "w"))
st = st_try
# TOUR_SKIP : la sonde ne doit pas apparaître comme une session Claude, sinon elle se relancerait elle-même.
out = subprocess.run(
    [os.path.expanduser("~/.local/bin/claude"), "--print", "--no-session-persistence", "--model", "haiku", "--tools", "",
     "--strict-mcp-config", "--mcp-config", '{"mcpServers":{}}', "--effort", "low",
     "--output-format", "stream-json", "--verbose", "Réponds seulement OK."],
    cwd=os.path.expanduser("~"), env={**os.environ, "TOUR_SKIP": "1"}, capture_output=True, text=True, timeout=120).stdout
for line in out.splitlines():
    if '"rate_limit_event"' in line:
        w = json.loads(line)["rate_limit_info"]["unifiedWindows"]
        win = lambda k: k in w and {"pct": round(w[k]["utilization"] * 100), "resets_at": w[k]["resetsAt"]}
        usage = {"five_hour": win("five_hour"), "seven_day": win("seven_day"), "ts": now}
        st["resets_at"] = w["five_hour"]["resetsAt"]
        body = json.dumps({"hook_event_name": "usage", "usage": {"claude": usage}}).encode()
        urllib.request.urlopen(urllib.request.Request(read("url") + "/e?src=usage&host=" + read("host"), body,
                                                      {"Content-Type": "application/json", "X-Tour-Token": read("secret")}), timeout=5)
        break
json.dump(st, open(STATE, "w"))
